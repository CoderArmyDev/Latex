{
  "name": "latex",
  "version": "0.1.0",
  "description": "A lightweight JavaScript engine for parsing and rendering a subset of LaTeX syntax into HTML.",
  "license": "MIT",
  "author": "Jit Dhank",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
